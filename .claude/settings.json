{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run build)",
      "Bash(npm run build:pages)",
      "Bash(npm run test *)",
      "Bash(npm run e2e)",
      "Bash(npm ci)",
      "Bash(npx vitest *)",
      "Bash(npx vitest)",
      "Bash(npx oxlint *)",
      "Bash(npx oxlint)",
      "Bash(npx tsc *)",
      "Bash(npx playwright test *)",
      "Bash(npx playwright test)",
      "Bash(uv run pytest *)",
      "Bash(uv run pytest)",
      "Bash(cd backend && uv run pytest *)",
      "Bash(cd backend && uv run pytest)",
      "Bash(git status *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git diff)",
      "Bash(git log *)",
      "Bash(git log)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/parity-reminder.sh",
            "statusMessage": "Checking dual-implementation parity",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
